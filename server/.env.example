# Local development only (App Hosting uses apphosting.yaml + Secret Manager instead).  cp .env.example .env.local
PROCTOR_SECRET=paste-64-hex-chars        # openssl rand -hex 32   (JWT signing key)
PROCTOR_PEPPER=paste-other-64-hex-chars  # openssl rand -hex 32   (mixed into roll-number hashes; never change after go-live)
PROCTOR_ADMIN_USER=admin
PROCTOR_ADMIN_PASS=change-me
ALLOWED_ORIGINS=http://localhost:3000
FIREBASE_SERVICE_ACCOUNT=                # service-account JSON on ONE line (Firebase console > Project settings > Service accounts)
UPSTASH_REDIS_REST_URL=                  # from console.upstash.com (leave empty to disable rate limiting in dev)
UPSTASH_REDIS_REST_TOKEN=
